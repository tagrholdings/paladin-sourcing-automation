# Copie este arquivo para .env (uso local) ou configure estas mesmas
# chaves em Railway -> Settings -> Variables (producao). NUNCA
# commitar o arquivo .env de verdade — ele ja esta no .gitignore.

# Secret gerado em Settings -> Integrations -> Webhooks no painel da
# Paladin Sourcing. Usado para verificar a assinatura HMAC de cada
# webhook recebido. CONFIRMAR: o token que voce ja tem em maos e
# exatamente esse secret de webhook, ou e outro tipo de credencial
# (API key geral)? Se for outra coisa, pergunte ao suporte da Paladin
# qual variavel corresponde ao secret de assinatura.
PALADIN_WEBHOOK_SECRET=

# Chave de API do Gemini (aistudio.google.com/apikey). Usado via
# endpoint compativel com OpenAI do Gemini (ver classifier.js).
# IMPORTANTE: gere uma chave NOVA antes de usar em producao — qualquer
# chave compartilhada em chat deve ser revogada.
GEMINI_API_KEY=
# Modelo usado para classificar as mensagens. Ajuste conforme o que
# estiver disponivel/atualizado na sua conta Gemini.
GEMINI_MODEL=gemini-2.5-flash

# URL do Incoming Webhook do Slack (api.slack.com/apps -> seu app ->
# Incoming Webhooks -> Add New Webhook to Workspace). Formato:
# https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ
SLACK_WEBHOOK_URL=

# Signing Secret do app do Slack (Basic Information -> App Credentials),
# usado para verificar que os cliques no botao "Send" das notificacoes
# realmente vem do Slack. So e necessario se voce ativou Interactivity
# no app (ver comentario de topo de src/routes/slackInteractions.js
# para o passo a passo). Sem isso, o sistema roda normal, so que sem o
# botao de enviar funcionando.
SLACK_SIGNING_SECRET=

# Porta HTTP (Railway define isso automaticamente — so necessario localmente)
PORT=3000

# Pausa manual da automacao: se PAUSED=true, o webhook responde 503 e
# nao processa nenhuma mensagem recebida (a Paladin re-tenta depois,
# nao perde o evento). Deixar vazio/false para rodar normalmente.
PAUSED=false

# Login do dashboard do Paladin Sourcing (crm.paladinsourcing.com), usado
# pelo cliente NAO OFICIAL em src/services/paladinApiClient.js para enviar
# mensagens, star/archive de conversas, e buscar dados de contato —
# funcionalidades que a API oficial documentada ainda nao oferece (suporte
# do Paladin contatado em 14/10 e 20/10/2026, sem resposta sobre isso).
# RECOMENDADO: preencher e-mail e senha — o servico faz login sozinho e
# renova a sessao quando ela expira. Credenciais sensiveis: so no Railway /
# .env.local, nunca commitar.
PALADIN_EMAIL=
PALADIN_PASSWORD=

# Alternativa manual (so se nao usar o login automatico acima): cookie de
# sessao copiado do DevTools (logado -> Application -> Cookies). Expira
# periodicamente e precisa ser renovado na mao; se expirar, a automacao
# pausa e avisa no Slack.
PALADIN_SESSION_COOKIE=

# Botao "Send as lead" (encaminha o lead + conversa por DM no Slack para
# quem recebe as leads, com o nome do advisor dono). Sem as duas variaveis
# o botao nao aparece.
#  - SLACK_DM_TOKEN: token xoxb- (bot do app, scope chat:write; a DM chega
#    "do app") ou xoxp- (token de usuario, scope user chat:write; a DM chega
#    como se fosse voce). Ver src/services/slackDm.js.
#  - LEAD_RECIPIENT_SLACK_ID: member ID (U...) da Chrysete — perfil dela no
#    Slack -> "..." -> "Copy member ID".
SLACK_DM_TOKEN=
LEAD_RECIPIENT_SLACK_ID=
