# Copie este arquivo para .env (uso local) ou configure estas mesmas
# chaves em Railway -> Settings -> Variables (producao). NUNCA
# commitar o arquivo .env de verdade — ele ja esta no .gitignore.

# Secret gerado em Settings -> Integrations -> Webhooks no painel da
# Paladin Sourcing. Usado para verificar a assinatura HMAC de cada
# webhook recebido. CONFIRMAR: o token que voce ja tem em maos e
# exatamente esse secret de webhook, ou e outro tipo de credencial
# (API key geral)? Se for outra coisa, pergunte ao suporte da Paladin
# qual variavel corresponde ao secret de assinatura.
PALADIN_WEBHOOK_SECRET=

# Chave de API do Gemini (aistudio.google.com/apikey). Usado via
# endpoint compativel com OpenAI do Gemini (ver classifier.js).
# IMPORTANTE: gere uma chave NOVA antes de usar em producao — qualquer
# chave compartilhada em chat deve ser revogada.
GEMINI_API_KEY=
# Modelo usado para classificar as mensagens. Ajuste conforme o que
# estiver disponivel/atualizado na sua conta Gemini.
GEMINI_MODEL=gemini-2.5-flash

# URL do Incoming Webhook do Slack (api.slack.com/apps -> seu app ->
# Incoming Webhooks -> Add New Webhook to Workspace). Formato:
# https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ
SLACK_WEBHOOK_URL=

# Porta HTTP (Railway define isso automaticamente — so necessario localmente)
PORT=3000

# Pausa manual da automacao: se PAUSED=true, o webhook responde 503 e
# nao processa nenhuma mensagem recebida (a Paladin re-tenta depois,
# nao perde o evento). Deixar vazio/false para rodar normalmente.
PAUSED=false

# Cookie de sessao do dashboard do Paladin Sourcing (crm.paladinsourcing.com),
# usado pelo cliente NAO OFICIAL em src/services/paladinApiClient.js para
# enviar mensagens, star/archive de conversas, e buscar dados de contato —
# funcionalidades que a API oficial documentada ainda nao oferece (suporte
# do Paladin contatado em 14/10 e 20/10/2026, sem resposta sobre isso).
# Copiar do DevTools (logado em crm.paladinsourcing.com -> Application ->
# Cookies) e colar aqui. ATENCAO: expira periodicamente e precisa ser
# renovado manualmente (nao ha login automatizado ainda). Trate como
# credencial sensivel — nunca commitar o valor real.
PALADIN_SESSION_COOKIE=
