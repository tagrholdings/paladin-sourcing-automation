{
  "name": "paladin-sourcing-automation",
  "version": "0.1.0",
  "description": "Triagem automatica de respostas de leads do Paladin Sourcing: webhook -> classificacao por IA -> roteamento pela matriz Menlo -> notificacao no Slack",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "export-conversations": "node scripts/export-conversations.js",
    "build-response-bank": "node scripts/build-response-bank.js",
    "refresh-responses": "node scripts/export-conversations.js && node scripts/build-response-bank.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "openai": "^4.60.0",
    "dotenv": "^16.4.5"
  },
  "license": "UNLICENSED",
  "private": true
}
